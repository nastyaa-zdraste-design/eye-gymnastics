{
  "name": "eye-gymnastics",
  "productName": "Гимнастика для глаз",
  "version": "1.0.0",
  "description": "Напоминание делать гимнастику для глаз: раз в час, поверх всех окон, со звуком и анекдотом в конце.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "__OWNER__",
  "homepage": "https://github.com/__OWNER__/__REPO__",
  "repository": {
    "type": "git",
    "url": "https://github.com/__OWNER__/__REPO__.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.eyegymnastics",
    "productName": "Гимнастика для глаз",
    "files": [
      "src/**",
      "content/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Eye-Gymnastics-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.healthcare-fitness",
      "identity": "-",
      "artifactName": "Eye-Gymnastics-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "__OWNER__",
      "repo": "__REPO__",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
